{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm ci --ignore-scripts)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm start)",
      "Bash(npm run android)",
      "Bash(npm run ios)",
      "Bash(npm run web)",
      "Bash(npm view:*)",
      "Bash(node -v)",
      "Bash(npm -v)",
      "Bash(npx tsc:*)",
      "Bash(npx jest:*)",
      "Bash(npx expo:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm add:*)",
      "Bash(npm update:*)",
      "Bash(npm up:*)",
      "Bash(npm audit fix:*)",
      "Bash(npx expo install:*)"
    ]
  }
}
