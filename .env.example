# Copy this file to ".env" and fill in what you need. Both settings are
# optional. The EXPO_PUBLIC_ prefix is required for Expo to expose a value to
# the app, and Metro must be restarted (npx expo start -c) after a change.

# PocketBase server. With this set, accounts and the library live on the
# server and follow you across devices. Leave it empty to keep everything on
# the device. Setup steps are in pocketbase/README.md.
EXPO_PUBLIC_POCKETBASE_URL=

# OMDb API key. Only enables the "Fill from OMDb" button when adding a film
# or series. Get a free one (1,000 requests/day) at:
#   https://www.omdbapi.com/apikey.aspx
EXPO_PUBLIC_OMDB_API_KEY=
